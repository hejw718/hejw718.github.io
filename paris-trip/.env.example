# WeatherAPI.com API Key (範例檔案)
# 複製此檔案為 .env 並填入您的 API Key
# 註冊網址: https://www.weatherapi.com/signup.aspx
VITE_WEATHER_API_KEY=020f932fb6014dd4ab595743250112

# Google Maps Platform API Key
# 註冊網址: https://console.cloud.google.com/google/maps-apis
# 需啟用 Directions API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
